# Copy this file to .env for local testing (do not commit the real .env)
# In Railway, set this under your service's Variables tab instead of using a file.

ANTHROPIC_API_KEY=sk-ant-your-key-here

# Railway sets PORT automatically — you don't need to set it yourself.
# Only needed for scanned photos/handwriting, or unusually-formatted PDFs.
# Plain digital PDFs (the common case) are read for free without this.
